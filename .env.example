MOCK_MODE=true

# Model provider (OpenAI-compatible). Default: SiliconFlow.
# One base URL serves chat, embeddings and rerank; the service must expose /embeddings and /rerank too.
MODEL_PROVIDER=siliconflow
MODEL_API_KEY=
MODEL_BASE_URL=https://api.siliconflow.cn/v1
MODEL_CHAT_MODEL=Qwen/Qwen3-8B
MODEL_EMBEDDING_MODEL=BAAI/bge-m3
MODEL_EMBEDDING_DIMENSIONS=1024
MODEL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
MODEL_TIMEOUT_SECONDS=60

DATABASE_PATH=./data/customer_service.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
