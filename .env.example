MOCK_MODE=true

# Model provider (OpenAI-compatible). Default: SiliconFlow.
# One base URL serves chat, embeddings and rerank; the service must expose /embeddings and /rerank too.
MODEL_PROVIDER=siliconflow
# Required for real Embedding / Rerank, including `python -m app.scripts_seed`.
# For a no-network demo, set MODEL_PROVIDER=offline. Docker Compose uses that
# explicit mode when MODEL_PROVIDER is unset.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.siliconflow.cn/v1
MODEL_CHAT_MODEL=Qwen/Qwen3-8B
MODEL_EMBEDDING_MODEL=BAAI/bge-m3
MODEL_EMBEDDING_DIMENSIONS=1024
MODEL_RERANK_MODEL=BAAI/bge-reranker-v2-m3
MODEL_TIMEOUT_SECONDS=60

# Default is a local SQLite file. Set DATABASE_URL to switch drivers, e.g.
# DATABASE_URL=postgresql://user:password@localhost:5432/customer_service
DATABASE_PATH=./data/customer_service.db
DATABASE_URL=
# LangGraph checkpoint store for Human Review pauses.
# Default: {DATABASE_PATH}.checkpoints for SQLite, ./data/checkpoints.db otherwise.
CHECKPOINT_PATH=
# langgraph is the only production path; fallback is for tests/degradation only.
WORKFLOW_ENGINE=langgraph
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Read-only Agent Loop: trigger on intent=chat, low router confidence or multi-step read-only ask.
AGENT_LOOP_MAX_STEPS=4
AGENT_LOOP_MAX_TOOL_CALLS=6
AGENT_LOOP_MAX_TOKENS=1500
AGENT_LOOP_CONFIDENCE_THRESHOLD=0.7
